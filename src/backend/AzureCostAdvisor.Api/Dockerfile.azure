FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/backend/AzureCostAdvisor.Api/AzureCostAdvisor.Api.csproj", "src/backend/AzureCostAdvisor.Api/"]
COPY ["src/backend/AzureCostAdvisor.Core/AzureCostAdvisor.Core.csproj", "src/backend/AzureCostAdvisor.Core/"]
RUN dotnet restore "src/backend/AzureCostAdvisor.Api/AzureCostAdvisor.Api.csproj"

COPY . .
WORKDIR /src/src/backend/AzureCostAdvisor.Api
RUN dotnet publish "AzureCostAdvisor.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 8080

ENV ASPNETCORE_URLS=http://0.0.0.0:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    ASPNETCORE_ENVIRONMENT=Production

COPY --from=build --chown=app:app /app/publish .

USER app
ENTRYPOINT ["dotnet", "AzureCostAdvisor.Api.dll"]
